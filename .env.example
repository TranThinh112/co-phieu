# Local configuration (copy to .env; never commit .env)
# Use Railway public DATABASE_URL only when local DB access is enabled.
DATABASE_URL=
DB_BACKEND=postgres
RUN_SCHEDULER=true
SCAN_INTERVAL_SECONDS=300
DATA_PROVIDER=public_api
LOG_LEVEL=INFO

# PostgreSQL connection. DATABASE_URL takes precedence.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=co_phieu
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Optional market/news credentials
VNDIRECT_API_KEY=
VNDIRECT_API_SECRET=
VNDIRECT_ACCOUNT_NO=
